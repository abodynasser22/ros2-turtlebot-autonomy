Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 40
      Color: 200; 200; 200
      Alpha: 0.5
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Obstacles and keep-out rings
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /mpc_obstacles
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Burger
      Enabled: true
      Alpha: 1
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      TF Prefix: ""
      Update Interval: 0
      Visual Enabled: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Plank and discs
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /mpc_footprint
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Path
      Name: MPC prediction
      Enabled: true
      Alpha: 1
      Buffer Length: 1
      Color: 0; 140; 60
      Line Style: Lines
      Line Width: 0.03
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Topic:
        Value: /mpc_prediction
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Predicted obstacle and goal (ghosts)
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /mpc_ghosts
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
  Enabled: true
  Global Options:
    Background Color: 250; 250; 248
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      X: 1.0
      Y: 0.0
      Scale: 260
      Angle: 0
      Near Clip Distance: 0.01
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Height: 800
  Width: 1280
  Hide Left Dock: true
  Hide Right Dock: true
  X: 0
  Y: 0
